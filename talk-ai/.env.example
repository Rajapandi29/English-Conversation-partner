# ==========================================
# TalkCraft Fullstack Application Environment
# ==========================================

# 1. Google Gemini AI API Key (Get from Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. PostgreSQL Database Credentials
POSTGRES_USER=talkcraft_user
POSTGRES_PASSWORD=talkcraft_password
POSTGRES_DB=talkcraft_db
POSTGRES_PORT=5432

# 3. Backend & Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
